@startuml US072_SD
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Air Transport Company\nCollaborator" as ATCC
participant ":ListCompanyFleetUI" as UI
participant ":ListCompanyFleetController" as CTRL
participant "Repositories" as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "atccRepository\n:ATCCRepository" as ATCC_REPO
participant "aircraftRepository\n:AircraftRepository" as AC_REPO
participant "authorizationService\n:AuthorizationService" as AUTH
participant "ApplicationSession" as APP_SESSION
participant "appSession\n:ApplicationSession" as APP_SESSION_SINGLETON
participant "currentSession\n:UserSession" as CURRENT_SESSION

activate ATCC

    ATCC -> UI : asks to list company fleet
    activate UI
        UI --> CTRL** : create()

        UI -> CTRL : getFilterOptions()
        activate CTRL
            CTRL --> UI : filterOptions
        deactivate CTRL

        UI --> ATCC : asks for filter criteria\n(none / model / maker / capacity / age)
    deactivate UI

    ATCC -> UI : selects filter criteria
    activate UI

        UI -> CTRL : listCompanyFleet(filterType, filterValue)
        activate CTRL

            CTRL -> AUTH : ensureAuthenticatedUserHasAnyOf(AIR_TRANSPORT_COMPANY_COLLABORATOR)
            activate AUTH
                AUTH --> CTRL
            deactivate AUTH

            |||
            CTRL -> CTRL : getCompanyFromSession()
            activate CTRL
                CTRL -> APP_SESSION : getInstance()
                activate APP_SESSION
                    APP_SESSION --> CTRL : appSession
                deactivate APP_SESSION

                CTRL -> APP_SESSION_SINGLETON : getCurrentSession()
                activate APP_SESSION_SINGLETON
                    APP_SESSION_SINGLETON --> CTRL : currentSession
                deactivate APP_SESSION_SINGLETON

                CTRL -> CURRENT_SESSION : getUserEmail()
                activate CURRENT_SESSION
                    CURRENT_SESSION --> CTRL : email
                deactivate CURRENT_SESSION

                CTRL -> REPOS : getInstance()
                activate REPOS
                    REPOS --> CTRL : repositories
                deactivate REPOS

                CTRL -> REPOS_SINGLETON : getATCCRepository()
                activate REPOS_SINGLETON
                    REPOS_SINGLETON --> CTRL : atccRepository
                deactivate REPOS_SINGLETON

                CTRL -> ATCC_REPO : findByUserEmail(email)
                activate ATCC_REPO
                    ATCC_REPO --> CTRL : atcc
                deactivate ATCC_REPO

                CTRL --> CTRL : companyIataCode
            deactivate CTRL

            |||
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> REPOS_SINGLETON : getAircraftRepository()
            activate REPOS_SINGLETON
                REPOS_SINGLETON --> CTRL : aircraftRepository
            deactivate REPOS_SINGLETON

            CTRL -> AC_REPO : findByCompanyAndFilter(companyIataCode, filterType, filterValue)
            activate AC_REPO
                AC_REPO --> CTRL : aircraftList
            deactivate AC_REPO

            CTRL --> UI : aircraftList
        deactivate CTRL

        UI --> ATCC : shows filtered aircraft list
    deactivate UI

deactivate ATCC
@enduml
